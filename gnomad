#!/bin/bash

print_logo() {
    cat << EOF
                                                       888 
                                                       888 
                                                       888 
 .d88b.  88888b.   .d88b.  88888b.d88b.   8888b.   .d88888 
d88P"88b 888 "88b d88""88b 888 "888 "88b     "88b d88" 888 
888  888 888  888 888  888 888  888  888 .d888888 888  888 
Y88b 888 888  888 Y88..88P 888  888  888 888  888 Y88b 888 
 "Y88888 888  888  "Y88P"  888  888  888 "Y888888  "Y88888  (${DISTRO_STR:-ARCH})
     888                                                   
Y8b d88P                                                   
